# ─────────────────────────────────────────────────────────────────────────────
# StrangerLink — environment example
# Copy to `.env` (root) and fill in. Frontend vars (VITE_*) are read at BUILD time.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Turso) --------------------------------------------------------
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-turso-token

# --- Web / API server --------------------------------------------------------
PORT=4200
# CORS allowlist for the REST API (comma-separated). Empty = reflect any (DEV ONLY).
# In prod set to your real origin(s), e.g. https://strangerlink.app
ALLOWED_ORIGINS=

# Admin token for the moderation endpoint GET /api/reports.
# If UNSET, that endpoint returns 404 (disabled). Set a long random value in prod.
ADMIN_TOKEN=

# --- Signal server -----------------------------------------------------------
SIGNAL_PORT=4201
# WebSocket origin allowlist (comma-separated). Empty = allow any (DEV ONLY).
# In prod set to your real origin(s), e.g. https://strangerlink.app
SIGNAL_ALLOWED_ORIGINS=
# Abuse limits (defaults shown)
SIGNAL_MAX_PEERS=5000
SIGNAL_MAX_CONNS_PER_IP=20

# --- Frontend (VITE_*, build-time) -------------------------------------------
# Signaling URL resolution:
#   - In prod over HTTPS the app auto-uses wss://<same-host>/signal (reverse proxy).
#   - Override explicitly here if your signal server lives elsewhere.
# VITE_SIGNAL_URL=wss://strangerlink.app/signal
# VITE_SIGNAL_PORT=4201   # dev only, standalone signal port

# --- TURN (STRONGLY recommended for production video reliability) ------------
# Without TURN, ~10-20% of users behind strict NATs/firewalls cannot connect.
# Use coturn (self-hosted) or a provider (Twilio / Cloudflare / Metered).
# VITE_TURN_URL=turn:turn.yourdomain.com:3478
# VITE_TURN_USERNAME=your-turn-username
# VITE_TURN_CREDENTIAL=your-turn-credential
